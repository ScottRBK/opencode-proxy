# OpenCode Proxy - Environment Variables
# Copy to .env and fill in the keys for providers you want to use.
# Only providers with keys set will be available.

# === Server Settings (OPENCODE_PROXY_ prefix) ===
# OPENCODE_PROXY_HOST=0.0.0.0
# OPENCODE_PROXY_PORT=4141
# OPENCODE_PROXY_LOG_LEVEL=INFO

# === Provider API Keys (standard env var names) ===

# OpenAI - https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic - https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Groq - https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Mistral - https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=...

# OpenRouter - https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Together AI - https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=...

# DeepInfra - https://deepinfra.com/dash/api_keys
# DEEPINFRA_API_KEY=...

# Perplexity - https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...

# xAI (Grok) - https://console.x.ai
# XAI_API_KEY=xai-...

# OpenCode Zen - https://opencode.ai (includes free Big Pickle model)
# OPENCODE_API_KEY=...
